# PostgreSQL Docker khusus development lokal.
# Salin nilai ini ke .env dan ganti password bila diperlukan.
POSTGRES_DB="smkhutama_local"
POSTGRES_USER="smkhutama"
POSTGRES_PASSWORD="ganti-password-development"
POSTGRES_PORT="5433"

DATABASE_URL="postgresql://smkhutama:ganti-password-development@127.0.0.1:5433/smkhutama_local?schema=public"
JWT_SECRET="ganti-dengan-random-string-minimal-32-karakter"

UPLOAD_DIR="./public/uploads"
MAX_IMAGE_SIZE="2048"
MAX_AUDIO_SIZE="10240"
MAX_VIDEO_SIZE="51200"
COOKIE_SECURE="false"
