// Prisma Schema - CBT SMK HUTAMA
// Database: PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  TEACHER
  STUDENT
  LANDING_ADMIN
  COUNSELOR
  PIKET
  KURIKULUM
  KESISWAAN
  ADMIN_CBT
}

enum Gender {
  MALE
  FEMALE
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_CHOICE_COMPLEX
  TRUE_FALSE
  MATCHING
  SHORT_ANSWER
  ESSAY
}

enum MediaType {
  NONE
  IMAGE
  AUDIO
  VIDEO
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ExamType {
  UH // Ulangan Harian
  UTS // Ujian Tengah Semester
  UAS // Ujian Akhir Semester
  US // Ujian Sekolah
  TRYOUT // Tryout / Latihan
  LAINNYA
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

enum Semester {
  GANJIL
  GENAP
}

enum CounselingType {
  PRIBADI
  SOSIAL
  BELAJAR
  KARIR
}

enum CounselingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REFERRED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CounselingSessionMode {
  INDIVIDUAL
  GROUP
  PARENT
  TEACHER
  ONLINE
}

enum ReferralStatus {
  PLANNED
  SENT
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum ViolationCategory {
  RINGAN
  SEDANG
  BERAT
}

enum RequestStatus {
  PENDING
  APPROVED
  SCHEDULED
  DONE
  REJECTED
}

enum SummonStatus {
  PENDING
  SENT
  DONE
}

enum QuestionSetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  USED
}

enum QuestionSetSource {
  TEACHER_IMPORT
  ADMIN_IMPORT
}

/// Penugasan tambahan. Satu pengguna dapat memegang beberapa tugas sekaligus.
enum AssignmentType {
  KURIKULUM
  KESISWAAN
  ADMIN_CBT
  COUNSELOR
  PIKET
  HOMEROOM_TEACHER
  STUDENT_ADVISOR
  OSIS_ADVISOR
  EXTRACURRICULAR_ADVISOR
  HEAD_OF_PROGRAM
  PKL_ADVISOR
  BKK
  LSP
  SAFE_SCHOOL_TEAM
  CMS
  PPDB
  LEADERSHIP
  FACILITIES
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
}

enum SensitiveAccessAction {
  VIEW
  PRINT
  EXPORT
}

// ============================================
// MODELS
// ============================================

/// Profil sekolah (hanya 1 record)
model SchoolProfile {
  id               String   @id @default(uuid())
  name             String
  logo             String?
  address          String?
  npsn             String?
  principalName    String?  @map("principal_name")
  letterhead       String?
  digitalSignature String?  @map("digital_signature")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("school_profiles")
}

/// Tahun ajaran
model AcademicYear {
  id        String   @id @default(uuid())
  year      String // e.g. "2025/2026"
  semester  Semester
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exams               Exam[]
  lessonSchedules     LessonSchedule[]
  teachingAssignments TeachingAssignment[]
  userAssignments     UserAssignment[]
  counselingCases     CounselingCase[]
  violationRecords    ViolationRecord[]
  achievementRecords  AchievementRecord[]
  counselingRequests  CounselingRequest[]
  parentSummons       ParentSummon[]
  homeVisits          HomeVisit[]
  surveys             Survey[]
  piketSchedules      PiketSchedule[]
  teacherAttendances  TeacherAttendance[]
  studentTardiness    StudentTardiness[]
  studentPermits      StudentPermit[]

  @@map("academic_years")
}

/// User (admin, guru, siswa)
model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student   Student?
  teacher   Teacher?
  counselor Counselor?

  assignments         UserAssignment[]     @relation("AssignmentUser")
  assignmentsCreated  UserAssignment[]     @relation("AssignmentCreator")
  permissionOverrides UserPermission[]     @relation("PermissionUser")
  permissionsGranted  UserPermission[]     @relation("PermissionGrantor")
  notifications       Notification[]
  sensitiveAccessLogs SensitiveAccessLog[]

  violationsRecorded   ViolationRecord[]   @relation("ViolationRecorder")
  achievementsRecorded AchievementRecord[] @relation("AchievementRecorder")
  profilesVerified     Student[]           @relation("StudentProfileVerifier")

  @@map("users")
}

/// Jurusan
model Major {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classes     Class[]
  students    Student[]
  subjects    Subject[]
  assignments UserAssignment[]

  @@map("majors")
}

/// Kelas
model Class {
  id                String   @id @default(uuid())
  name              String // e.g. "XII TKJ 1"
  grade             String // X, XI, XII
  majorId           String   @map("major_id")
  homeroomTeacherId String?  @map("homeroom_teacher_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  major               Major                @relation(fields: [majorId], references: [id])
  homeroomTeacher     Teacher?             @relation("Homeroom", fields: [homeroomTeacherId], references: [id])
  students            Student[]
  examParticipants    ExamClass[]
  teacherAttendances  TeacherAttendance[]
  lessonSchedules     LessonSchedule[]
  teachingAssignments TeachingAssignment[]
  assignments         UserAssignment[]

  @@map("classes")
}

/// Mata pelajaran
model Subject {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  majorId   String?  @map("major_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  major               Major?               @relation(fields: [majorId], references: [id])
  teachers            Teacher[]
  questions           Question[]
  questionSets        QuestionSet[]
  exams               Exam[]
  lessonSchedules     LessonSchedule[]
  teachingAssignments TeachingAssignment[]

  @@map("subjects")
}

/// Profil siswa
/// Status verifikasi biodata siswa oleh guru BK.
enum StudentProfileStatus {
  DRAFT // belum pernah dikirim siswa
  PENDING // menunggu verifikasi BK
  VERIFIED // sudah diverifikasi & terkunci
  REJECTED // dikembalikan ke siswa untuk diperbaiki
}

model Student {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  nis       String?  @unique
  nisn      String?  @unique
  classId   String?  @map("class_id")
  majorId   String?  @map("major_id")
  gender    Gender?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Biodata Buku Siswa (BK) ──
  // Diisi siswa lewat "Biodata Saya", lalu diverifikasi guru BK.
  birthPlace String?   @map("birth_place")
  birthDate  DateTime? @map("birth_date")
  address    String?
  parentPhone String?  @map("parent_phone")
  photoUrl   String?   @map("photo_url")
  /// Data kesehatan — sensitif, hanya BK yang boleh membaca.
  medicalHistory String? @map("medical_history")

  profileStatus      StudentProfileStatus @default(DRAFT) @map("profile_status")
  profileSubmittedAt DateTime?            @map("profile_submitted_at")
  profileVerifiedAt  DateTime?            @map("profile_verified_at")
  profileVerifiedById String?             @map("profile_verified_by_id")
  profileNote        String?              @map("profile_note")

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVerifiedBy  User?                @relation("StudentProfileVerifier", fields: [profileVerifiedById], references: [id])
  class              Class?               @relation(fields: [classId], references: [id])
  major              Major?               @relation(fields: [majorId], references: [id])
  attempts           StudentExamAttempt[]
  counselingCases    CounselingCase[]
  violationRecords   ViolationRecord[]
  achievementRecords AchievementRecord[]
  counselingRequests CounselingRequest[]
  parentSummons      ParentSummon[]
  homeVisits         HomeVisit[]
  surveyResponses    SurveyResponse[]
  tardinessRecords   StudentTardiness[]
  permits            StudentPermit[]

  @@index([profileStatus])
  @@map("students")
}

/// Profil guru
model Teacher {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  nip       String?  @unique
  subjectId String?  @map("subject_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject             Subject?             @relation(fields: [subjectId], references: [id])
  questions           Question[]
  questionSets        QuestionSet[]
  exams               Exam[]
  homeroomClasses     Class[]              @relation("Homeroom")
  attendances         TeacherAttendance[]
  piketSchedules      PiketSchedule[]
  lessonSchedules     LessonSchedule[]
  teachingAssignments TeachingAssignment[]

  @@map("teachers")
}

/// Paket bank soal hasil import guru/admin
model QuestionSet {
  id                  String            @id @default(uuid())
  title               String
  description         String?
  subjectId           String            @map("subject_id")
  ownerTeacherId      String            @map("owner_teacher_id")
  createdByUserId     String?           @map("created_by_user_id")
  createdByRole       Role              @default(TEACHER) @map("created_by_role")
  source              QuestionSetSource @default(TEACHER_IMPORT)
  examType            ExamType          @default(UTS) @map("exam_type")
  grade               String?
  sourceFileName      String?           @map("source_file_name")
  status              QuestionSetStatus @default(DRAFT)
  totalQuestions      Int               @default(0) @map("total_questions")
  multipleChoiceCount Int               @default(0) @map("multiple_choice_count")
  essayCount          Int               @default(0) @map("essay_count")
  invalidCount        Int               @default(0) @map("invalid_count")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  subject      Subject    @relation(fields: [subjectId], references: [id])
  ownerTeacher Teacher    @relation(fields: [ownerTeacherId], references: [id])
  questions    Question[]
  exams        Exam[]

  @@map("question_sets")
}

/// Bank soal
model Question {
  id               String       @id @default(uuid())
  subjectId        String       @map("subject_id")
  teacherId        String       @map("teacher_id")
  questionSetId    String?      @map("question_set_id")
  questionType     QuestionType @map("question_type")
  questionText     String       @map("question_text")
  mediaType        MediaType    @default(NONE) @map("media_type")
  mediaUrl         String?      @map("media_url")
  difficulty       Difficulty   @default(MEDIUM)
  scoreWeight      Float        @default(1) @map("score_weight")
  explanation      String?
  material         String?
  competency       String?
  grade            String?
  isRandomized     Boolean      @default(true) @map("is_randomized")
  randomizeOptions Boolean      @default(true) @map("randomize_options")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  subject       Subject          @relation(fields: [subjectId], references: [id])
  teacher       Teacher          @relation(fields: [teacherId], references: [id])
  questionSet   QuestionSet?     @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  options       QuestionOption[]
  examQuestions ExamQuestion[]
  answers       StudentAnswer[]

  @@map("questions")
}

/// Opsi jawaban (untuk soal PG, PGK, BS, Menjodohkan)
model QuestionOption {
  id          String  @id @default(uuid())
  questionId  String  @map("question_id")
  optionLabel String  @map("option_label") // A, B, C, D, E
  optionText  String  @map("option_text")
  mediaUrl    String? @map("media_url")
  isCorrect   Boolean @default(false) @map("is_correct")
  orderNumber Int     @default(0) @map("order_number")

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  StudentAnswer[]

  @@map("question_options")
}

/// Ujian / Paket Ujian
model Exam {
  id                           String     @id @default(uuid())
  title                        String
  subjectId                    String     @map("subject_id")
  teacherId                    String     @map("teacher_id")
  questionSetId                String?    @map("question_set_id")
  academicYearId               String?    @map("academic_year_id")
  durationMinutes              Int        @map("duration_minutes")
  startAt                      DateTime   @map("start_at")
  endAt                        DateTime   @map("end_at")
  requestedQuestionCount       Int?       @map("requested_question_count")
  requestedMultipleChoiceCount Int?       @map("requested_multiple_choice_count")
  requestedEssayCount          Int?       @map("requested_essay_count")
  multipleChoicePercentage     Float      @default(100) @map("multiple_choice_percentage")
  essayPercentage              Float      @default(0) @map("essay_percentage")
  randomizeQuestions           Boolean    @default(false) @map("randomize_questions")
  randomizeOptions             Boolean    @default(false) @map("randomize_options")
  showResult                   Boolean    @default(false) @map("show_result")
  showExplanation              Boolean    @default(false) @map("show_explanation")
  passingScore                 Float?     @map("passing_score") // KKM
  status                       ExamStatus @default(DRAFT)
  examType                     ExamType   @default(UH) @map("exam_type")
  createdAt                    DateTime   @default(now()) @map("created_at")
  updatedAt                    DateTime   @updatedAt @map("updated_at")

  subject      Subject              @relation(fields: [subjectId], references: [id])
  teacher      Teacher              @relation(fields: [teacherId], references: [id])
  questionSet  QuestionSet?         @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?        @relation(fields: [academicYearId], references: [id])
  questions    ExamQuestion[]
  classes      ExamClass[]
  sessions     ExamSession[]
  tokens       ExamToken[]
  attempts     StudentExamAttempt[]

  @@map("exams")
}

/// Soal dalam ujian (relasi many-to-many)
model ExamQuestion {
  id          String @id @default(uuid())
  examId      String @map("exam_id")
  questionId  String @map("question_id")
  orderNumber Int    @default(0) @map("order_number")

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@map("exam_questions")
}

/// Kelas peserta ujian
model ExamClass {
  id      String @id @default(uuid())
  examId  String @map("exam_id")
  classId String @map("class_id")

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id])

  @@unique([examId, classId])
  @@map("exam_classes")
}

/// Sesi ujian
model ExamSession {
  id          String   @id @default(uuid())
  examId      String   @map("exam_id")
  sessionName String   @map("session_name")
  roomName    String?  @map("room_name")
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  createdAt   DateTime @default(now()) @map("created_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_sessions")
}

/// Token ujian
model ExamToken {
  id        String   @id @default(uuid())
  examId    String   @map("exam_id")
  token     String   @unique
  expiredAt DateTime @map("expired_at")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_tokens")
}

/// Percobaan ujian siswa
model StudentExamAttempt {
  id             String        @id @default(uuid())
  examId         String        @map("exam_id")
  studentId      String        @map("student_id")
  startedAt      DateTime?     @map("started_at")
  submittedAt    DateTime?     @map("submitted_at")
  status         AttemptStatus @default(NOT_STARTED)
  score          Float?
  loginStatus    Boolean       @default(false) @map("login_status")
  ipAddress      String?       @map("ip_address")
  // Anti-cheat (mobile): kunci akses bila siswa berkali-kali keluar app
  isLocked       Boolean       @default(false) @map("is_locked")
  lockedAt       DateTime?     @map("locked_at")
  lockReason     String?       @map("lock_reason")
  violationCount Int           @default(0) @map("violation_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  exam    Exam            @relation(fields: [examId], references: [id])
  student Student         @relation(fields: [studentId], references: [id])
  answers StudentAnswer[]

  @@unique([examId, studentId])
  @@map("student_exam_attempts")
}

/// Jawaban siswa
model StudentAnswer {
  id               String   @id @default(uuid())
  attemptId        String   @map("attempt_id")
  questionId       String   @map("question_id")
  selectedOptionId String?  @map("selected_option_id")
  answerText       String?  @map("answer_text")
  isDoubtful       Boolean  @default(false) @map("is_doubtful")
  isCorrect        Boolean? @map("is_correct")
  score            Float?
  savedAt          DateTime @default(now()) @map("saved_at")

  attempt        StudentExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question           @relation(fields: [questionId], references: [id])
  selectedOption QuestionOption?    @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("student_answers")
}

/// Audit log (opsional)
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

/// Penugasan pengguna yang dapat dibatasi periode, kelas, dan jurusan.
model UserAssignment {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  type           AssignmentType
  academicYearId String?        @map("academic_year_id")
  classId        String?        @map("class_id")
  majorId        String?        @map("major_id")
  startDate      DateTime?      @map("start_date")
  endDate        DateTime?      @map("end_date")
  isActive       Boolean        @default(true) @map("is_active")
  note           String?
  createdById    String?        @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user         User          @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  class        Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  major        Major?        @relation(fields: [majorId], references: [id], onDelete: SetNull)

  @@index([userId, type, isActive])
  @@index([academicYearId])
  @@map("user_assignments")
}

/// Katalog capability agar fitur baru tidak bergantung pada role tunggal.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  category    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userOverrides UserPermission[]

  @@map("permissions")
}

/// Override izin per pengguna; allowed=false dapat mencabut izin bawaan role.
model UserPermission {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  permissionId String    @map("permission_id")
  allowed      Boolean   @default(true)
  expiresAt    DateTime? @map("expires_at")
  grantedById  String?   @map("granted_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User       @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("PermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([userId, allowed])
  @@map("user_permissions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType @default(INFO)
  title     String
  message   String
  href      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Jejak baca/cetak/ekspor data sensitif, terpisah dari audit mutasi biasa.
model SensitiveAccessLog {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  action       SensitiveAccessAction @default(VIEW)
  resourceType String                @map("resource_type")
  resourceId   String?               @map("resource_id")
  purpose      String?
  ipAddress    String?               @map("ip_address")
  userAgent    String?               @map("user_agent")
  createdAt    DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("sensitive_access_logs")
}

/// Pengaturan sistem (key-value)
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String?
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

// ============================================
// LANDING PAGE / CMS MODELS
// ============================================

enum RegistrationStatus {
  PENDING
  VERIFIED
  ACCEPTED
  REJECTED
}

/// Profil & konten hero landing page (single record)
model LandingProfile {
  id             String   @id @default(uuid())
  schoolName     String   @default("SMK Hutama Pondok Gede") @map("school_name")
  shortName      String   @default("SMK Hutama") @map("short_name")
  tagline        String?
  logoUrl        String?  @map("logo_url")
  heroBadge      String?  @map("hero_badge")
  heroTitle      String?  @map("hero_title")
  heroSubtitle   String?  @map("hero_subtitle")
  address        String?
  phone          String?
  whatsapp       String?
  email          String?
  officialUrl    String?  @map("official_url")
  instagram      String?
  facebook       String?
  youtube        String?
  ppdbOpen       Boolean  @default(true) @map("ppdb_open")
  vision         String?
  mission        String?
  history        String?
  principalName  String?  @map("principal_name")
  principalPhoto String?  @map("principal_photo")
  principalWord  String?  @map("principal_word")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

