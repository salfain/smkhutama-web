}

// ============================================
// BIMBINGAN KONSELING (SIBIKONS) MODELS
// ============================================

/// Profil Guru BK / Konselor
model Counselor {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  nip       String?  @unique
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases         CounselingCase[]
  sessions      CounselingSession[]
  referrals     CounselingReferral[]
  parentSummons ParentSummon[]
  homeVisits    HomeVisit[]

  @@map("counselors")
}

/// Master jenis pelanggaran + bobot poin
model ViolationType {
  id        String            @id @default(uuid())
  name      String
  category  ViolationCategory @default(RINGAN)
  points    Int               @default(0)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  records ViolationRecord[]

  @@map("violation_types")
}

/// Sesi / kasus konseling
model CounselingCase {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  counselorId    String           @map("counselor_id")
  academicYearId String           @map("academic_year_id")
  type           CounselingType   @default(PRIBADI)
  status         CounselingStatus @default(OPEN)
  priority       CasePriority     @default(MEDIUM)
  riskLevel      RiskLevel        @default(NONE) @map("risk_level")
  riskNotes      String?          @map("risk_notes")
  title          String
  description    String?
  notes          String?          @map("session_notes")
  followUp       String?          @map("follow_up")
  isConfidential Boolean          @default(true) @map("is_confidential")
  sessionDate    DateTime         @default(now()) @map("session_date")
  nextFollowUpAt DateTime?        @map("next_follow_up_at")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselor    Counselor            @relation(fields: [counselorId], references: [id])
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  sessions     CounselingSession[]
  referrals    CounselingReferral[]

  @@index([status, priority, nextFollowUpAt])
  @@map("counseling_cases")
}

/// Pertemuan/touchpoint di dalam satu kasus konseling.
model CounselingSession {
  id              String                @id @default(uuid())
  caseId          String                @map("case_id")
  counselorId     String                @map("counselor_id")
  sessionDate     DateTime              @default(now()) @map("session_date")
  durationMinutes Int                   @default(45) @map("duration_minutes")
  mode            CounselingSessionMode @default(INDIVIDUAL)
  location        String?
  summary         String
  intervention    String?
  outcome         String?
  nextPlan        String?               @map("next_plan")
  isConfidential  Boolean               @default(true) @map("is_confidential")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  case      CounselingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  counselor Counselor      @relation(fields: [counselorId], references: [id])

  @@index([caseId, sessionDate])
  @@map("counseling_sessions")
}

/// Rujukan kasus ke psikolog, fasilitas kesehatan, lembaga perlindungan, dll.
model CounselingReferral {
  id          String         @id @default(uuid())
  caseId      String         @map("case_id")
  counselorId String         @map("counselor_id")
  referredTo  String         @map("referred_to")
  institution String?
  contact     String?
  reason      String
  status      ReferralStatus @default(PLANNED)
  referredAt  DateTime       @default(now()) @map("referred_at")
  followUpAt  DateTime?      @map("follow_up_at")
  result      String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  case      CounselingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  counselor Counselor      @relation(fields: [counselorId], references: [id])

  @@index([caseId, status])
  @@map("counseling_referrals")
}

/// Catatan pelanggaran siswa (poin negatif)
model ViolationRecord {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  recordedById    String   @map("recorded_by_id")
  violationTypeId String?  @map("violation_type_id")
  academicYearId  String   @map("academic_year_id")
  description     String
  points          Int      @default(0)
  sanction        String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now()) @map("created_at")

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy    User           @relation("ViolationRecorder", fields: [recordedById], references: [id])
  violationType ViolationType? @relation(fields: [violationTypeId], references: [id])
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id])

  @@map("violation_records")
}

/// Catatan prestasi siswa (poin positif)
model AchievementRecord {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  recordedById   String   @map("recorded_by_id")
  academicYearId String   @map("academic_year_id")
  title          String
  description    String?
  points         Int      @default(0)
  level          String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy   User         @relation("AchievementRecorder", fields: [recordedById], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@map("achievement_records")
}

/// Permohonan konseling yang diajukan siswa
model CounselingRequest {
  id             String        @id @default(uuid())
  studentId      String        @map("student_id")
  academicYearId String        @map("academic_year_id")
  topic          String
  description    String?
  urgency        String        @default("SEDANG")
  preferredDate  DateTime?     @map("preferred_date")
  status         RequestStatus @default(PENDING)
  response       String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@map("counseling_requests")
}

/// Surat pemanggilan orang tua
model ParentSummon {
  id             String       @id @default(uuid())
  studentId      String       @map("student_id")
  counselorId    String       @map("counselor_id")
  academicYearId String       @map("academic_year_id")
  level          String // SP1 / SP2 / SP3 / PANGGILAN
  reason         String
  totalPoints    Int          @default(0) @map("total_points")
  meetingDate    DateTime?    @map("meeting_date")
  status         SummonStatus @default(PENDING)
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselor    Counselor    @relation(fields: [counselorId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@map("parent_summons")
}

/// Kunjungan rumah (home visit)
model HomeVisit {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  counselorId    String   @map("counselor_id")
  academicYearId String   @map("academic_year_id")
  visitDate      DateTime @default(now()) @map("visit_date")
  purpose        String
  address        String?
  findings       String?
  result         String?
  createdAt      DateTime @default(now()) @map("created_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselor    Counselor    @relation(fields: [counselorId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@map("home_visits")
}

/// Angket / asesmen kebutuhan siswa (AKPD)
model Survey {
  id             String   @id @default(uuid())
  title          String
  academicYearId String   @map("academic_year_id")
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  questions    SurveyQuestion[]
  responses    SurveyResponse[]
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])

  @@map("surveys")
}

model SurveyQuestion {
  id          String  @id @default(uuid())
  surveyId    String  @map("survey_id")
  text        String
  category    String?
  orderNumber Int     @default(0) @map("order_number")

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@map("survey_questions")
}

model SurveyResponse {
  id          String   @id @default(uuid())
  surveyId    String   @map("survey_id")
  studentId   String   @map("student_id")
  submittedAt DateTime @default(now()) @map("submitted_at")

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@unique([surveyId, studentId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String @id @default(uuid())
  responseId String @map("response_id")
  questionId String @map("question_id")
  value      Int    @default(0)

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@map("survey_answers")
}

// ============================================
// GURU PIKET MODELS
// ============================================

/// Jadwal guru piket mingguan yang ditentukan admin
model PiketSchedule {
  id             String   @id @default(uuid())
  teacherId      String   @map("teacher_id")
  academicYearId String   @map("academic_year_id")
  dayOfWeek      Int      @map("day_of_week") // 0 Minggu, 1 Senin, ... 6 Sabtu
  isActive       Boolean  @default(true) @map("is_active")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, teacherId, dayOfWeek])
  @@map("piket_schedules")
}

/// Jadwal mata pelajaran mingguan per kelas dan tahun ajaran
model LessonSchedule {
  id             String   @id @default(uuid())
  academicYearId String   @map("academic_year_id")
  classId        String   @map("class_id")
  subjectId      String   @map("subject_id")
  teacherId      String   @map("teacher_id")
  dayOfWeek      Int      @map("day_of_week") // 1 Senin, ... 6 Sabtu
  startTime      String   @map("start_time") // HH:mm
  endTime        String   @map("end_time") // HH:mm
  room           String?
  note           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])

  @@unique([academicYearId, classId, dayOfWeek, startTime])
  @@unique([academicYearId, teacherId, dayOfWeek, startTime])
  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@map("lesson_schedules")
}

/// Pembagian tugas mengajar guru per kelas dan tahun ajaran
model TeachingAssignment {
  id             String   @id @default(uuid())
  academicYearId String   @map("academic_year_id")
  teacherId      String   @map("teacher_id")
  subjectId      String   @map("subject_id")
  classId        String   @map("class_id")
  weeklyPeriods  Int      @map("weekly_periods")
  note           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([academicYearId, teacherId, subjectId, classId])
  @@index([academicYearId, classId])
  @@index([academicYearId, teacherId])
  @@map("teaching_assignments")
}

/// Kehadiran guru di kelas (dicatat guru piket)
model TeacherAttendance {
  id             String   @id @default(uuid())
  teacherId      String   @map("teacher_id")
  classId        String   @map("class_id")
  academicYearId String   @map("academic_year_id")
  recordedBy     String   @map("recorded_by")
  status         String // HADIR / TIDAK_HADIR / DIGANTIKAN / TUGAS_LUAR
  period         String?
  substitute     String?
  note           String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@map("teacher_attendances")
}

/// Pendataan siswa terlambat
model StudentTardiness {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  recordedBy     String   @map("recorded_by")
  academicYearId String   @map("academic_year_id")
  arrivalTime    DateTime @map("arrival_time")
  reason         String?
  sanction       String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@map("student_tardiness")
}

/// Izin keluar/masuk siswa saat jam pelajaran
model StudentPermit {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  recordedBy     String    @map("recorded_by")
  academicYearId String    @map("academic_year_id")
  type           String // KELUAR / MASUK
  reason         String
  exitTime       DateTime? @map("exit_time")
  returnTime     DateTime? @map("return_time")
  status         String    @default("KELUAR") // KELUAR / SUDAH_KEMBALI / TIDAK_KEMBALI
  date           DateTime  @default(now())
  createdAt      DateTime  @default(now()) @map("created_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@map("student_permits")
}
